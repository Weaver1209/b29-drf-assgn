# Django Secret Key (generate a secure random key for production)
SECRET_KEY=your-secret-key-here

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,your-production-domain.com

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# CSRF Trusted Origins (comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# CORS Allow Credentials
CORS_ALLOW_CREDENTIALS=True

# Media Files Configuration (optional overrides)
# MEDIA_URL=/media/
# MEDIA_ROOT=media
